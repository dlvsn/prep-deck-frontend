# Copy to .env (git-ignored) and adjust. Shared by the desktop and the web build.
# The client has no mocks: prep-deck-backend must be running at this address.
VITE_API_URL=http://localhost:8080/api
# Development only: every topic arrives with this role, to check the editor and read-only UI
# against a backend that has no sharing yet and answers owner. Leave empty normally.
VITE_FORCE_ROLE=
